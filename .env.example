# ==============================================================================
# LeakLens — Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH REAL LOCAL/STAGING VALUES.
# NEVER COMMIT THE ACTUAL .env FILE OR ANY SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Runtime Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Port (Azure App Service automatically sets this at runtime)
PORT=3000

# Allowed Client Origin for CORS (Frontend URL in development)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Database Configuration (Microsoft SQL Server / Azure SQL Database)
# ------------------------------------------------------------------------------
# Server hostname or FQDN (e.g. 'localhost' or 'leaklens-sql.database.windows.net')
DB_SERVER=localhost

# SQL Server Port (default: 1433)
DB_PORT=1433

# Database Name
DB_NAME=LeakLensDB

# Authentication Type: 'default' (SQL user/password) or 'azure-active-directory-default' (Managed Identity)
AZURE_SQL_AUTH_TYPE=default

# Least-privileged database user account (when using SQL authentication)
DB_USER=leaklens_app

# Database password (leave blank in example template)
DB_PASSWORD=

# Enable encryption for TDS connection (required for Azure SQL, recommended for MSSQL)
DB_ENCRYPT=true

# Trust server certificate (MUST be 'false' in production; set to 'true' ONLY for local self-signed certs)
DB_TRUST_SERVER_CERTIFICATE=false

# Connection timeout in milliseconds
DB_CONNECTION_TIMEOUT=15000

# Request timeout in milliseconds
DB_REQUEST_TIMEOUT=30000

# Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN=1

# ------------------------------------------------------------------------------
# Azure Blob Storage Configuration (Private File Persistence)
# ------------------------------------------------------------------------------
# Storage account name (used with Managed Identity in Azure)
AZURE_STORAGE_ACCOUNT_NAME=

# Storage container name for authorized files (default: 'leaklens-scans')
AZURE_STORAGE_CONTAINER_NAME=leaklens-scans

# Connection string (optional: for local development with Azurite emulator or access key)
AZURE_STORAGE_CONNECTION_STRING=

# ------------------------------------------------------------------------------
# Azure Key Vault Configuration (Runtime Secrets Management)
# ------------------------------------------------------------------------------
# Key Vault resource name (e.g. 'leaklens-kv-prod')
AZURE_KEYVAULT_NAME=

# Key Vault Vault URI (e.g. 'https://leaklens-kv-prod.vault.azure.net/')
KEY_VAULT_URI=

# ------------------------------------------------------------------------------
# Security, Session & Monitoring
# ------------------------------------------------------------------------------
# High-entropy cryptographic secret for session signing and token validation (min 32 characters)
SESSION_SECRET=

# Azure Application Insights connection string (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Log Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info
