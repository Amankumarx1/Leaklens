# ==============================================================================
# LeakLens — Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH REAL LOCAL/STAGING VALUES.
# NEVER COMMIT THE ACTUAL .env FILE OR ANY SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Runtime Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Port
PORT=3000

# Allowed Client Origin for CORS (Frontend URL)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Database Configuration (Microsoft SQL Server / Azure SQL Database)
# ------------------------------------------------------------------------------
# Server hostname or IP address (e.g. 'localhost' or 'leaklens-sql.database.windows.net')
DB_SERVER=localhost

# SQL Server Port (default: 1433)
DB_PORT=1433

# Database Name
DB_NAME=LeakLensDB

# Least-privileged database user account
DB_USER=leaklens_app

# Database password (leave blank in example template)
DB_PASSWORD=

# Enable encryption for TDS connection (required for Azure SQL, recommended for MSSQL)
DB_ENCRYPT=true

# Trust server certificate (Set to 'false' in production with valid TLS certificates;
# set to 'true' ONLY in local development with self-signed dev certificates)
DB_TRUST_SERVER_CERTIFICATE=false

# Connection timeout in milliseconds
DB_CONNECTION_TIMEOUT=15000

# Request timeout in milliseconds
DB_REQUEST_TIMEOUT=30000

# Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN=1

# ------------------------------------------------------------------------------
# Security & Session Secrets
# ------------------------------------------------------------------------------
# High-entropy cryptographic secret for session signing and token validation (min 32 characters)
SESSION_SECRET=

# Log Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info
